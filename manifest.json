{
  "id": "workspaces-per-monitor",
  "name": "Workspaces Per Monitor",
  "version": "1.2.0",
  "author": "TheRuckh <elruckh@gmail.com>",
  "description": "Windows-style paired workspace switcher: Display 1 shows 1-infinite, Display 2 shows A1-infinite, switching in sync.",
  "license": "MIT",
  "official": false,
  "hosts": [
    "topbarGlyph"
  ],
  "entryPoints": {
    "main": "service/Main.qml",
    "content": "content/Widget.qml",
    "panel": "content/Panel.qml"
  },
  "panel": {
    "width": 320
  },
  "files": [
    "preview.png",
    "assets/preview-widget.png",
    "bin/ryoku-paired-workspaces"
  ],
  "capabilities": {
    "densities": [
      "glyph",
      "compact"
    ]
  },
  "defaults": {
    "host": "topbarGlyph",
    "label": "Workspaces",
    "bar": {
      "section": "left"
    }
  },
  "dependencies": {
    "commands": [
      "hyprctl",
      "jq"
    ]
  },
  "metadata": {
    "settings": [
      {
        "key": "desktopCount",
        "type": "int",
        "label": "Minimum virtual desktops",
        "group": "Pairing",
        "default": 5
      },
      {
        "key": "secondaryPrefix",
        "type": "text",
        "label": "Secondary display prefix (e.g. A)",
        "group": "Pairing",
        "default": "A"
      },
      {
        "key": "primaryMonitor",
        "type": "text",
        "label": "Primary monitor (empty = auto-detect)",
        "group": "Monitors",
        "default": ""
      },
      {
        "key": "secondaryMonitor",
        "type": "text",
        "label": "Secondary monitor (empty = auto-detect)",
        "group": "Monitors",
        "default": ""
      }
    ]
  }
}
